rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function canUseSharedInventory(workspaceId) {
      return request.auth != null && workspaceId == "shared";
    }

    match /inventory/{workspaceId}/{document=**} {
      allow read, write: if canUseSharedInventory(workspaceId);
    }
  }
}
